{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "carlab-api-edge",
  "main": "src/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.carlab.top",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
    {
      "name": "EMAIL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
}
